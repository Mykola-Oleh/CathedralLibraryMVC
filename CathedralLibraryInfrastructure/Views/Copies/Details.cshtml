@model CathedralLibraryDomain.Model.Copy

@{
    ViewData["Title"] = "Деталі примірника";
}

<div class="container py-4">

    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm mb-4 border-0 bg-body-tertiary">
                <div class="card-header bg-primary bg-gradient text-white border-0 py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-info-circle me-2"></i>Інформація про одиницю зберігання</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary fw-normal">Видання</dt>
                        <dd class="col-sm-8 fw-bold">
                            <span class="text-primary">📖 @Model.Publication.Title</span>
                        </dd>

                        <hr class="my-3 opacity-10" />

                        <dt class="col-sm-4 text-secondary fw-normal">Інвентарний номер</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary-subtle text-secondary-emphasis">#@Model.Copynumber</span></dd>

                        <dt class="col-sm-4 text-secondary fw-normal">Поточний статус</dt>
                        <dd class="col-sm-8">
                            @{
                                var statusClass = Model.Status?.StatusName == "В наявності" ? "bg-success" : "bg-warning text-dark";
                            }
                            <span class="badge @statusClass rounded-pill px-3">
                                @(Model.Status?.StatusName ?? "Невизначено")
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm border-0 bg-body-tertiary">
                <div class="card-header bg-dark bg-gradient text-white border-0 py-3">
                    <h5 class="card-title mb-0">⚙️ Керування</h5>
                </div>
                <div class="card-body py-4">
                    <div class="d-grid gap-3">
                        @if (User.IsInRole("admin"))
                        {
                            <a href="@Url.Action("Edit", new { id = Model.PublicationId, copyNum = Model.Copynumber })" class="btn btn-warning py-2 fw-bold shadow-sm">
                                ✏️ Редагувати дані
                            </a>
                        }
                        <button onclick="history.back()" class="btn btn-outline-secondary py-2">
                            ⬅️ Повернутися назад
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>