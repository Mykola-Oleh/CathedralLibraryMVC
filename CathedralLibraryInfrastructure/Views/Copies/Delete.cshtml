@model CathedralLibraryDomain.Model.Copy

@{
    ViewData["Title"] = "Видалення примірника";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger bg-gradient text-white border-0 py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Підтвердження видалення
                    </h5>
                </div>

                <div class="card-body py-4">
                    <div class="text-center mb-4">
                        <div class="display-6 text-danger mb-2">🗑️</div>
                        <h4 class="fw-bold">Ви впевнені?</h4>
                        <p class="text-muted">Цю дію неможливо буде скасувати</p>
                    </div>

                    <div class="bg-light-subtle rounded-3 p-3 mb-4 border-start border-danger border-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-5 text-secondary small text-uppercase">Видання:</dt>
                            <dd class="col-sm-7 fw-bold">@Model.Publication.Title</dd>

                            <dt class="col-sm-5 text-secondary small text-uppercase">Інвентарний №:</dt>
                            <dd class="col-sm-7">
                                <span class="badge bg-dark">#@Model.Copynumber</span>
                            </dd>

                            <dt class="col-sm-5 text-secondary small text-uppercase">Поточний статус:</dt>
                            <dd class="col-sm-7 text-danger">@Model.Status.StatusName</dd>
                        </dl>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="PublicationId" />
                        <input type="hidden" asp-for="Copynumber" />

                        <div class="d-grid gap-2 d-md-flex justify-content-center">
                            <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm fw-bold">
                                Підтвердити видалення
                            </button>
                            <a asp-action="Index" asp-route-id="@Model.PublicationId" class="btn btn-outline-secondary btn-lg px-4">
                                Скасувати
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>