@model CathedralLibraryInfrastructure.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Реєстрація";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border rounded-3">
                <div class="card-body p-4 p-md-5">
                    <h2 class="text-center mb-4 fw-bold text-primary">Реєстрація</h2>

                    <form method="post" asp-controller="Account" asp-action="Register">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="First_name" class="form-label fw-semibold"></label>
                                <input asp-for="First_name" class="form-control" placeholder="Ім'я" />
                                <span asp-validation-for="First_name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Last_name" class="form-label fw-semibold"></label>
                                <input asp-for="Last_name" class="form-control" placeholder="Прізвище" />
                                <span asp-validation-for="Last_name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="email@knu.ua" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Year" class="form-label fw-semibold"></label>
                            <select asp-for="Year" class="form-select" asp-items="ViewBag.Years">
                                <option value="" disabled selected>Оберіть курс...</option>
                            </select>
                            <span asp-validation-for="Year" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PasswordConfirm" class="form-label fw-semibold"></label>
                            <input asp-for="PasswordConfirm" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="PasswordConfirm" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">
                                Зареєструватися
                            </button>
                        </div>

                        <div class="text-center mt-3 small">
                            Вже є аккаунт? <a asp-action="Login" class="text-decoration-none">Увійти</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}