@model CathedralLibraryDomain.Model.PublicationType

<div class="container mt-4">
    <div class="card shadow-sm col-md-6 mx-auto">
        <div class="card-header bg-warning text-white">
            <h4>Новий тип видання</h4>
        </div>
        <div class="card-body">
            <form asp-action="CreatePublicationType">
                <div class="mb-3">
                    <label class="form-label fw-bold">Назва</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" asp-route-tab="PublicationType" class="btn btn-secondary">⬅ Назад</a>
                    <button type="submit" class="btn btn-success">➕ Створити</button>
                </div>
            </form>
        </div>
    </div>
</div>