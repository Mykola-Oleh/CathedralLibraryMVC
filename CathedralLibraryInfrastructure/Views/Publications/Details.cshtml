@model CathedralLibraryDomain.Model.Publication

@{
    ViewData["Title"] = "Деталі видання";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <h1 class="mb-0">📖 @Model.Title</h1>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">📝 Загальна інформація</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Анотація</dt>
                        <dd class="col-sm-9">
                            <p class="text-justify">@(string.IsNullOrEmpty(Model.Annotation) ? "Анотація відсутня" : Model.Annotation)</p>
                        </dd>

                        <hr />

                        <dt class="col-sm-3 text-muted">Тип видання</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-info text-dark">@Model.PublicationType?.Name</span>
                        </dd>

                        <dt class="col-sm-3 text-muted">Рік видання</dt>
                        <dd class="col-sm-9">@Model.Year р.</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mb-4 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">✍️ Автори</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @if (Model.Authors != null && Model.Authors.Any())
                    {
                        foreach (var author in Model.Authors)
                        {
                            <li class="list-group-item d-flex align-items-center">
                                <span class="me-2">👤</span>
                                <div>
                                    <strong>@author.LastName</strong> @author.FirstName
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted small">Авторів не вказано</li>
                    }
                </ul>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (User.IsInRole("admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                ✏️ Редагувати
                            </a>
                        }
                        <button onclick="history.back()" class="btn btn-outline-secondary">
                            ⬅️ Назад до списку
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>