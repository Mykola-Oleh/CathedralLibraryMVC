@model IEnumerable<CathedralLibraryDomain.Model.Publication>
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Видання";
    var wishlistIds = ViewBag.WishlistIds as List<Guid> ?? new List<Guid>();
}

<h1>Видання</h1>
<div class="mb-3 d-flex gap-2 flex-wrap">
@if (User.IsInRole("admin")){
    
        <a asp-action="Create" class="btn btn-success">
            ➕ Додати видання
        </a>
}
        <a asp-action="AllCopies" asp-controller="Copies" class="btn btn-outline-primary">
            📋 Усі примірники
        </a>
    @if (User.IsInRole("admin"))
    {
        <div class="ms-auto">
            <a asp-action="Import" asp-controller="Publications" class="btn btn-outline-secondary">
                📥 Імпорт
            </a>
            <a asp-action="Export" asp-controller="Publications" class="btn btn-outline-secondary">
                📤 Експорт
            </a>
        </div>
    }
</div>
<form asp-action="Index" method="get" class="form-inline mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control"
               placeholder="Пошук за назвою або автором..."
               value="@ViewBag.CurrentFilter" />
        <button type="submit" class="btn btn-primary">Пошук</button>
        <a asp-action="Index" class="btn btn-secondary">Скинути</a>
    </div>
</form>
<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewBag.TitleSortParm" class="text-decoration-none text-dark">
                    Назва видання @(ViewBag.TitleSortParm == "name_desc" ? "▼" : "▲")
                </a>
            </th>
            <th>Анотація</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewBag.TypeSortParm" class="text-decoration-none text-dark">
                    Тип @(ViewBag.TypeSortParm == "Type" ? "▲" : "▼")
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewBag.YearSortParm" class="text-decoration-none text-dark">
                    Рік @(ViewBag.YearSortParm == "Year" ? "▲" : "▼")
                </a>
            </th>
            <th>Автори</th>
            <th class="text-end">Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.Title</td>
                <td class="text-muted" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    @item.Annotation
                </td>
                <td>@item.PublicationType?.Name</td>
                <td>@item.Year</td>
                <td>
                    @if (item.Authors != null && item.Authors.Any())
                    {
                        <span class="text-nowrap">
                            @string.Join(", ", item.Authors.Select(a =>
                            (!string.IsNullOrEmpty(a.FirstName) ? a.FirstName[0] + ". " : "") + a.LastName))
                </span>
                                }
                    else
                    {
                        <span class="text-muted small italic">Не вказано</span>
                    }
                </td>
                <td class="text-end text-nowrap">
                    <div class="btn-group" role="group">
                        <a asp-action="Copies" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Примірники">
                            📖 Примірники
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Деталі">
                            🔍
                        </a>
                        <form asp-controller="Wishlist" asp-action="Add" method="post" style="display:inline;">
                            <input type="hidden" name="publicationId" value="@item.Id" />
                            <button type="button"
                                    class="btn @(wishlistIds.Contains(item.Id) ? "btn-danger" : "btn-outline-danger") btn-sm wishlist-toggle"
                                    data-id="@item.Id">
                                <i>❤</i>
                            </button>
                        </form>
                        
                        @if (User.IsInRole("admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Редагувати">
                                ✏️
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Видалити">
                                🗑️
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buttons = document.querySelectorAll(".wishlist-toggle");

            buttons.forEach(btn => {
                btn.addEventListener("click", function () {
                    const pubId = this.getAttribute("data-id");
                    const currentBtn = this;
                    currentBtn.style.opacity = "0.5";

                    fetch(`/Wishlist/ToggleWishlist?publicationId=${pubId}`, {
                        method: "POST",
                        credentials: 'include',
                        headers: {
                            "X-Requested-With": "XMLHttpRequest",
                            "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        }
                    })
                    .then(response => {
                        if (response.status === 401) {
                            alert("Будь ласка, увійдіть в систему, щоб додавати в обране.");
                            return;
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data && data.success) {
                            if (data.action === "added") {
                                currentBtn.classList.replace("btn-outline-danger", "btn-danger");
                            } else {
                                currentBtn.classList.replace("btn-danger", "btn-outline-danger");
                            }
                        }
                    })
                    .catch(error => console.error("Помилка:", error))
                    .finally(() => {
                        currentBtn.style.opacity = "1";
                    });
                });
            });
        });
    </script>
}