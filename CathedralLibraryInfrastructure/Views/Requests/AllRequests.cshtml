@model IEnumerable<CathedralLibraryDomain.Model.Request>

@{
    ViewData["Title"] = "Керування запитами";
}

<div class="container mt-4">
    <h2>📋 Усі запити бібліотеки</h2>

    <div class="card shadow-sm mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Читач</th>
                        <th>Видання</th>
                        <th>Інвентарний №</th>
                        <th>Дата запиту</th>
                        <th>Статус</th>
                        <th>Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Reader.LastName @item.Reader.FirstName</td>
                            <td class="fw-bold">@item.Copy.Publication.Title</td>
                            <td class="text-center">@item.Copynumber</td>
                            <td>@item.RequestDate.ToShortDateString()</td>
                            <td>
                                <span class="badge @(item.StatusId == 1 ? "bg-warning text-dark" : item.StatusId == 2 ? "bg-success" : "bg-danger")">
                                    @item.Status.StatusName
                                </span>
                            </td>
                            <td>
                                @if (item.StatusId == 1)
                                {
                                    <div class="d-flex gap-2">
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-success">✅ Затвердити</button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">❌ Відхилити</button>
                                        </form>
                                    </div>
                                }
                                @if (item.StatusId == 4)
                                {
                                    <form asp-action="ConfirmReturn" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary">📥 Підтвердити отримання книги</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>