@using Microsoft.AspNetCore.Identity
@model CathedralLibraryInfrastructure.ViewModels.ChangeRoleViewModel

@{
    ViewData["Title"] = "Управління правами доступу";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark bg-gradient text-white border-0 py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-person-gear me-2"></i>Налаштування прав доступу
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4 p-3 bg-light rounded-3 border">
                        <div class="ms-3">
                            <h6 class="text-secondary mb-1 small text-uppercase fw-bold">Користувач</h6>
                            <p class="h5 mb-0 fw-bold text-dark">@Model.UserEmail</p>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-3">Виберіть доступні ролі:</h6>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="userId" value="@Model.UserId" />

                        <div class="list-group mb-4 shadow-sm">
                            @foreach (IdentityRole role in Model.AllRoles)
                            {
                                <label class="list-group-item list-group-item-action d-flex align-items-center py-3 border-start-0 border-end-0">
                                    <div class="form-check w-100">
                                        <input class="form-check-input me-3" type="checkbox" name="roles"
                                               id="role_@role.Id" value="@role.Name"
                                               @(Model.UserRoles.Contains(role.Name) ? "checked=\"checked\"" : "") />
                                        <span class="form-check-label h6 mb-0 d-inline-block">
                                            @role.Name
                                            @if (Model.UserRoles.Contains(role.Name))
                                            {
                                                <span class="badge rounded-pill bg-success-subtle text-success ms-2 small">Активна</span>
                                            }
                                        </span>
                                    </div>
                                </label>
                            }
                        </div>

                        <hr class="my-4 text-secondary opacity-25">

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="UserList" class="btn btn-outline-secondary px-4 me-md-2">
                                Скасувати
                            </a>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm fw-bold">
                                <i class="bi bi-check2-circle me-2"></i>Зберегти зміни
                            </button>
                        </div>
                    </form>
                </div>
            </div>
    </div>
</div>