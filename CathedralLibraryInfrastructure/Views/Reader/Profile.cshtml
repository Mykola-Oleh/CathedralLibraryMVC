@model UserProfileViewModel
@{
    ViewData["Title"] = "Мій профіль";

    var activeBooks = Model.ActiveRequests
        .Where(r => r.StatusId == 2 && r.ReturnDate == null)
        .ToList();

    var historyBooks = Model.ActiveRequests
        .Where(r => r.ReturnDate != null || r.StatusId == 5)
        .ToList();
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <img src="https://ui-avatars.com/api/?name=@Model.FullName&background=0D6EFD&color=fff&size=128"
                             class="rounded-circle shadow" alt="Avatar">
                    </div>
                    <h4 class="fw-bold">@Model.FullName</h4>
                    <p class="text-muted">@Model.Position</p>
                    <hr>
                    <div class="text-start">
                        <p><strong>Email:</strong> @Model.Email</p>
                        <p><strong>Факультет:</strong> @Model.Faculty</p>
                        <p><strong>Кафедра:</strong> @Model.Department</p>
                        <p><strong>Курс:</strong> @Model.Year</p>
                    </div>
                    <a asp-action="Edit" class="btn btn-outline-primary btn-sm w-100">Редагувати дані</a>
                </div>
            </div>
        </div>

        <div class="col-md-8">

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold">📖 Книги на руках</div>
                <div class="card-body">
                    @if (activeBooks.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Назва</th>
                                        <th>Термін до</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in activeBooks)
                                    {
                                        <tr>
                                            <td>@req.Copy.Publication.Title</td>
                                            <td class="@(req.DueDate < DateTime.Now ? "text-danger fw-bold" : "")">
                                                @req.DueDate.ToShortDateString()
                                            </td>
                                            <td>
                                                <span class="badge bg-success">Видано</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">У вас зараз немає виданих книг.</p>
                    }
                </div>
            </div>

            @if (historyBooks.Any())
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light fw-bold">📜 Історія читання (повернуті)</div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm text-muted">
                                <thead>
                                    <tr>
                                        <th>Назва</th>
                                        <th>Була у вас до</th>
                                        <th>Повернуто</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in historyBooks)
                                    {
                                        <tr>
                                            <td>@req.Copy.Publication.Title</td>
                                            <td>@req.DueDate.ToShortDateString()</td>
                                            <td>
                                                <span class="text-success fw-bold">
                                                    ✅ @req.ReturnDate?.ToShortDateString()
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>