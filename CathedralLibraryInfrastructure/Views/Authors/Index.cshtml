@model IEnumerable<CathedralLibraryDomain.Model.Author>

@{
    ViewData["Title"] = "Автори";
}

<h1>Автори</h1>

@if (User.IsInRole("admin"))
{
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            ➕ Додати автора
        </a>
    </div>
}

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th class="text-end">Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    <span class="fw-bold">@Html.DisplayFor(modelItem => item.LastName)</span>
                </td>
                <td class="text-end text-nowrap">
                    <div class="btn-group" role="group">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Деталі">
                            🔍
                        </a>
                        @if (User.IsInRole("admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Редагувати">
                                ✏️
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Видалити">
                                🗑️
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>