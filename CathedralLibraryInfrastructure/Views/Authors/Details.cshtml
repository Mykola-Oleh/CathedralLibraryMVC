@model CathedralLibraryDomain.Model.Author

@{
    ViewData["Title"] = "Деталі автора";
}

<div class="container py-4">

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 bg-body-tertiary mb-4">
                <div class="card-header bg-success bg-gradient text-white border-0 py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-person-lines-fill me-2"></i>Дані автора</h5>
                </div>
                <div class="card-body py-4">
                    <h3 class="fw-bold mb-1">@Model.LastName</h3>
                    <p class="text-secondary fs-5 mb-4">@Model.FirstName</p>

                    <div class="d-flex justify-content-between align-items-center p-3 rounded bg-dark bg-opacity-10">
                        <span class="text-secondary">Всього праць у бібліотеці:</span>
                        <span class="badge bg-success rounded-pill px-3 fs-6">
                            @(Model.Publications?.Count ?? 0)
                        </span>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pb-4">
                    <div class="d-grid gap-2">
                        @if (User.IsInRole("admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold shadow-sm">
                                ✏️ Редагувати профіль
                            </a>
                        }
                        <button onclick="history.back()" class="btn btn-outline-secondary">
                            ⬅️ Назад до списку
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0 bg-body-tertiary">
                <div class="card-header bg-dark bg-gradient text-white border-0 py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-journal-bookmark-fill me-2"></i>Список робіт</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Publications != null && Model.Publications.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Назва</th>
                                        <th class="text-center">Рік</th>
                                        <th class="text-end pe-4">Дії</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pub in Model.Publications.OrderByDescending(p => p.Year))
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <span class="fw-medium text-primary">📖 @pub.Title</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@pub.Year</span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <a asp-controller="Publications" asp-action="Details" asp-route-id="@pub.Id" class="btn btn-sm btn-link text-decoration-none">
                                                    Переглянути →
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                            У цього автора поки що немає зареєстрованих робіт.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>