@model CathedralLibraryDomain.Model.Author

@{
    ViewData["Title"] = "Видалення автора";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger bg-gradient text-white border-0 py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Підтвердження видалення
                    </h5>
                </div>

                <div class="card-body py-4">
                    <div class="text-center mb-4">
                        <div class="display-6 text-danger mb-2">🗑️</div>
                        <h4 class="fw-bold">Ви видаляєте автора</h4>
                        <p class="text-muted small">Цю дію неможливо буде скасувати</p>
                    </div>

                    <div class="bg-body-secondary rounded-3 p-3 mb-4 border-start border-danger border-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-secondary small text-uppercase">Ім'я:</dt>
                            <dd class="col-sm-8 fw-bold">
                                @Html.DisplayFor(model => model.FirstName)
                            </dd>

                            <dt class="col-sm-4 text-secondary small text-uppercase mt-2">Прізвище:</dt>
                            <dd class="col-sm-8 fw-bold mt-2">
                                @Html.DisplayFor(model => model.LastName)
                            </dd>
                        </dl>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-2 d-md-flex justify-content-center">
                            <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm fw-bold">
                                Видалити
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                Скасувати
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>