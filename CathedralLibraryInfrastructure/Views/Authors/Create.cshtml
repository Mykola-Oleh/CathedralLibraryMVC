@model CathedralLibraryDomain.Model.Author

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-4">
    <div class="card shadow-sm col-md-6 mx-auto">
        <div style="background-color:#c41ab6; color: #000;" class="card-header  text-white">
            <h4>Новий тип видання</h4>
        </div>
        <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="FirstName" class="control-label fw-bold"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
                <div class="mb-3">
                    <label asp-for="LastName" class="control-label fw-bold"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Index" asp-route-tab="PublicationType" class="btn btn-secondary">⬅ Назад</a>
                <button type="submit" class="btn btn-success">➕ Створити</button>
            </div>
        </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
