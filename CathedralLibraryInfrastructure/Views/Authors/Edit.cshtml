@model CathedralLibraryDomain.Model.Author

@{
    ViewData["Title"] = "Редагування автора";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-body-tertiary">
                <div class="card-header bg-warning bg-gradient text-dark border-0 py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Редагувати профіль автора
                    </h5>
                </div>
                <div class="card-body py-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label text-secondary small fw-bold text-uppercase"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Введіть ім'я" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LastName" class="form-label text-secondary small fw-bold text-uppercase"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Введіть прізвище" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <hr class="my-4 opacity-10" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">
                                ✅ Зберегти зміни
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Скасувати
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}